rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /formations_gw/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /formations_multi/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /formations_high/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /portalConfig/recruitment {
      function recruitmentAdmin() {
        return request.auth != null
          && request.auth.uid == 'wJRZibao8FgMDqDDQ3csPdVuGkx1';
      }
      function validRecruitment() {
        let d = request.resource.data;
        return d.keys().hasAll(['text', 'updatedAt'])
          && d.keys().hasOnly(['text', 'updatedAt'])
          && d.text is string
          && d.text.size() > 0
          && d.text.size() <= 10000
          && d.updatedAt is timestamp
          && d.updatedAt == request.time;
      }
      allow get: if true;
      allow list: if false;
      allow create, update: if recruitmentAdmin() && validRecruitment();
      allow delete: if false;
    }
    match /publicTools/yosenPredictor {
      function validScore(v) { return v is int && v >= 0 && v <= 9007199254740991; }
      function validSharedData() {
        let d = request.resource.data;
        return d.keys().hasAll(['schemaVersion','eventDate','dayType','score12','score18','score20','updatedAt'])
          && d.keys().hasOnly(['schemaVersion','eventDate','dayType','score12','score18','score20','earlyAvgSpeed','updatedAt'])
          && d.schemaVersion == 1 && d.schemaVersion is int
          && d.eventDate is string && d.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.dayType in ['weekday','saturday','sunday','holiday']
          && validScore(d.score12)
          && (!d.keys().hasAny(['earlyAvgSpeed']) || d.earlyAvgSpeed == null || (validScore(d.earlyAvgSpeed) && d.earlyAvgSpeed > 0))
          && (d.score18 == null || (validScore(d.score18) && d.score18 > d.score12))
          && (d.score20 == null || (d.score18 != null && validScore(d.score20) && d.score20 > d.score18))
          && d.updatedAt is timestamp && d.updatedAt == request.time;
      }
      allow get: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'wJRZibao8FgMDqDDQ3csPdVuGkx1'
        && validSharedData();
      allow delete: if false;
    }
    // 本戦戦況は既存の予選管理者だけが閲覧・編集できる。
    match /gwBattleReviews/{session}/entries/{entry} {
      function battleAdmin() {
        return request.auth != null && request.auth.uid == 'wJRZibao8FgMDqDDQ3csPdVuGkx1';
      }
      function score(v) { return v == null || (v is number && v >= 0 && v <= 9007199254740991); }
      function base(v) {
        return v == null || (v is map
          && v.keys().hasAll(['enemyContrib12','enemySpeed','ownContrib12','ownSpeed'])
          && v.keys().hasOnly(['enemyContrib12','enemySpeed','ownContrib12','ownSpeed'])
          && score(v.enemyContrib12) && score(v.enemySpeed) && score(v.ownContrib12) && score(v.ownSpeed));
      }
      function validMeta(d) {
        return d.keys().hasAll(['schemaVersion','dateJst','dayKey','dayType','base','migrationId','updatedAt'])
          && d.keys().hasOnly(['schemaVersion','dateJst','dayKey','dayType','base','migrationId','updatedAt'])
          && d.schemaVersion is int && d.schemaVersion == 1
          && d.dateJst is string && d.dateJst.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && d.dayKey in ['day1','day2','day3','day4'] && session == d.dateJst + '_' + d.dayKey
          && d.dayType in ['weekday','weekend'] && base(d.base)
          && d.migrationId is string && d.migrationId.size() > 0 && d.migrationId.size() <= 80;
      }
      function validRecord(d) {
        return d.keys().hasAll(['time','own','enemy','updatedAt'])
          && d.keys().hasOnly(['time','own','enemy','updatedAt'])
          && d.time is string && d.time.matches('^((0[7-9]|1[0-9]|2[0-3]):[0-5][0-9]|24:00)$')
          && entry == d.time.replace(':', '')
          && score(d.own) && score(d.enemy)
          && existsAfter(/databases/$(database)/documents/gwBattleReviews/$(session)/entries/meta);
      }
      allow read: if true;
      allow create, update: if battleAdmin()
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time
        && ((entry == 'meta' && validMeta(request.resource.data)
            && (resource == null || request.resource.data.migrationId == resource.data.migrationId))
          || (entry.matches('^((0[7-9]|1[0-9]|2[0-3])[0-5][0-9]|2400)$') && validRecord(request.resource.data)));
      allow delete: if battleAdmin() && entry.matches('^((0[7-9]|1[0-9]|2[0-3])[0-5][0-9]|2400)$');
    }
    // Member identities are server-managed. Knowing a profile ID grants no access.
    function memberOwnsProfile(profileId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/memberIdentities/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.profileId == profileId
        && exists(/databases/$(database)/documents/memberProfiles/$(profileId))
        && get(/databases/$(database)/documents/memberProfiles/$(profileId)).data.status == 'active';
    }
    match /memberIdentities/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /memberProfiles/{profileId} {
      allow get: if memberOwnsProfile(profileId);
      allow list, write: if false;
      match /devices/{deviceId} {
        allow read: if memberOwnsProfile(profileId);
        allow write: if false;
      }
      match /settings/speedCalculator {
        function hellSeconds(v) { return v is int && v >= 0 && v <= 3599; }
        function validSpeedSettings(d) {
          let fields = ['schemaVersion','hellTimesSec','intervalSec','revision','createdAt','updatedAt','updatedByDeviceId'];
          let levels = ['90','95','100','150','200','250'];
          return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
            && d.schemaVersion is int && d.schemaVersion == 1
            && d.hellTimesSec is map
            && d.hellTimesSec.keys().hasAll(levels) && d.hellTimesSec.keys().hasOnly(levels)
            && hellSeconds(d.hellTimesSec['90']) && hellSeconds(d.hellTimesSec['95'])
            && hellSeconds(d.hellTimesSec['100']) && hellSeconds(d.hellTimesSec['150'])
            && hellSeconds(d.hellTimesSec['200']) && hellSeconds(d.hellTimesSec['250'])
            && d.intervalSec is number && d.intervalSec >= 0 && d.intervalSec <= 15
            // Compare with the canonical tenth, not an exact v * 10 remainder.
            && d.intervalSec == int(d.intervalSec * 10 + 0.5) / 10.0
            && d.revision is int && d.revision >= 1 && d.revision <= 9007199254740991
            && d.createdAt is timestamp && d.updatedAt is timestamp
            && d.updatedByDeviceId is string
            && d.updatedByDeviceId == get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.deviceId;
        }
        allow get: if memberOwnsProfile(profileId);
        allow list, delete: if false;
        allow create: if memberOwnsProfile(profileId) && validSpeedSettings(request.resource.data)
          && request.resource.data.revision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if memberOwnsProfile(profileId) && validSpeedSettings(request.resource.data)
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
