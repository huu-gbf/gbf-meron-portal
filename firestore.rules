rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /formations_gw/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /formations_multi/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /formations_high/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /portalConfig/recruitment {
      function recruitmentAdmin() {
        return request.auth != null
          && request.auth.uid == 'wJRZibao8FgMDqDDQ3csPdVuGkx1';
      }
      function validRecruitment() {
        let d = request.resource.data;
        return d.keys().hasAll(['text', 'updatedAt'])
          && d.keys().hasOnly(['text', 'updatedAt'])
          && d.text is string
          && d.text.size() > 0
          && d.text.size() <= 10000
          && d.updatedAt is timestamp
          && d.updatedAt == request.time;
      }
      allow get: if true;
      allow list: if false;
      allow create, update: if recruitmentAdmin() && validRecruitment();
      allow delete: if false;
    }
    match /publicTools/yosenPredictor {
      function validScore(v) { return v is int && v >= 0 && v <= 9007199254740991; }
      function validSharedData() {
        let d = request.resource.data;
        return d.keys().hasAll(['schemaVersion','eventDate','dayType','score12','score18','score20','updatedAt'])
          && d.keys().hasOnly(['schemaVersion','eventDate','dayType','score12','score18','score20','earlyAvgSpeed','updatedAt'])
          && d.schemaVersion == 1 && d.schemaVersion is int
          && d.eventDate is string && d.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.dayType in ['weekday','saturday','sunday','holiday']
          && validScore(d.score12)
          && (!d.keys().hasAny(['earlyAvgSpeed']) || d.earlyAvgSpeed == null || (validScore(d.earlyAvgSpeed) && d.earlyAvgSpeed > 0))
          && (d.score18 == null || (validScore(d.score18) && d.score18 > d.score12))
          && (d.score20 == null || (d.score18 != null && validScore(d.score20) && d.score20 > d.score18))
          && d.updatedAt is timestamp && d.updatedAt == request.time;
      }
      allow get: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'wJRZibao8FgMDqDDQ3csPdVuGkx1'
        && validSharedData();
      allow delete: if false;
    }
    // 本戦戦況は既存の予選管理者だけが閲覧・編集できる。
    match /gwBattleReviews/{session}/entries/{entry} {
      function battleAdmin() {
        return request.auth != null && request.auth.uid == 'wJRZibao8FgMDqDDQ3csPdVuGkx1';
      }
      function score(v) { return v == null || (v is number && v >= 0 && v <= 9007199254740991); }
      function base(v) {
        return v == null || (v is map
          && v.keys().hasAll(['enemyContrib12','enemySpeed','ownContrib12','ownSpeed'])
          && v.keys().hasOnly(['enemyContrib12','enemySpeed','ownContrib12','ownSpeed'])
          && score(v.enemyContrib12) && score(v.enemySpeed) && score(v.ownContrib12) && score(v.ownSpeed));
      }
      function validMeta(d) {
        return d.keys().hasAll(['schemaVersion','dateJst','dayKey','dayType','base','migrationId','updatedAt'])
          && d.keys().hasOnly(['schemaVersion','dateJst','dayKey','dayType','base','migrationId','updatedAt'])
          && d.schemaVersion is int && d.schemaVersion == 1
          && d.dateJst is string && d.dateJst.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && d.dayKey in ['day1','day2','day3','day4'] && session == d.dateJst + '_' + d.dayKey
          && d.dayType in ['weekday','weekend'] && base(d.base)
          && d.migrationId is string && d.migrationId.size() > 0 && d.migrationId.size() <= 80;
      }
      function validRecord(d) {
        return d.keys().hasAll(['time','own','enemy','updatedAt'])
          && d.keys().hasOnly(['time','own','enemy','updatedAt'])
          && d.time is string && d.time.matches('^((0[7-9]|1[0-9]|2[0-3]):[0-5][0-9]|24:00)$')
          && entry == d.time.replace(':', '')
          && score(d.own) && score(d.enemy)
          && existsAfter(/databases/$(database)/documents/gwBattleReviews/$(session)/entries/meta);
      }
      allow read: if true;
      allow create, update: if battleAdmin()
        && request.resource.data.updatedAt is timestamp && request.resource.data.updatedAt == request.time
        && ((entry == 'meta' && validMeta(request.resource.data)
            && (resource == null || request.resource.data.migrationId == resource.data.migrationId))
          || (entry.matches('^((0[7-9]|1[0-9]|2[0-3])[0-5][0-9]|2400)$') && validRecord(request.resource.data)));
      allow delete: if battleAdmin() && entry.matches('^((0[7-9]|1[0-9]|2[0-3])[0-5][0-9]|2400)$');
    }
    // Member identities are server-managed. Knowing a profile ID grants no access.
    function memberOwnsProfile(profileId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/memberIdentities/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.profileId == profileId
        && exists(/databases/$(database)/documents/memberProfiles/$(profileId))
        && get(/databases/$(database)/documents/memberProfiles/$(profileId)).data.status == 'active';
    }
    match /memberIdentities/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /memberProfiles/{profileId} {
      allow get: if memberOwnsProfile(profileId);
      allow list, write: if false;
      match /devices/{deviceId} {
        allow read: if memberOwnsProfile(profileId);
        allow write: if false;
      }
      match /settings/speedCalculator {
        function hellSeconds(v) { return v is int && v >= 0 && v <= 3599; }
        function validSpeedSettings(d) {
          let fields = ['schemaVersion','hellTimesSec','intervalSec','revision','createdAt','updatedAt','updatedByDeviceId'];
          let levels = ['90','95','100','150','200','250'];
          return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
            && d.schemaVersion is int && d.schemaVersion == 1
            && d.hellTimesSec is map
            && d.hellTimesSec.keys().hasAll(levels) && d.hellTimesSec.keys().hasOnly(levels)
            && hellSeconds(d.hellTimesSec['90']) && hellSeconds(d.hellTimesSec['95'])
            && hellSeconds(d.hellTimesSec['100']) && hellSeconds(d.hellTimesSec['150'])
            && hellSeconds(d.hellTimesSec['200']) && hellSeconds(d.hellTimesSec['250'])
            && d.intervalSec is number && d.intervalSec >= 0 && d.intervalSec <= 15
            // Compare with the canonical tenth, not an exact v * 10 remainder.
            && d.intervalSec == int(d.intervalSec * 10 + 0.5) / 10.0
            && d.revision is int && d.revision >= 1 && d.revision <= 9007199254740991
            && d.createdAt is timestamp && d.updatedAt is timestamp
            && d.updatedByDeviceId is string
            && d.updatedByDeviceId == get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.deviceId;
        }
        allow get: if memberOwnsProfile(profileId);
        allow list, delete: if false;
        allow create: if memberOwnsProfile(profileId) && validSpeedSettings(request.resource.data)
          && request.resource.data.revision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if memberOwnsProfile(profileId) && validSpeedSettings(request.resource.data)
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time;
      }
      match /settings/historyReadState {
        // History additionally requires the identity's current device to be active.
        // Keep this check local so existing speed/profile permissions do not change.
        function historyOwnsProfile() {
          return memberOwnsProfile(profileId)
            && get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.deviceId is string
            && exists(/databases/$(database)/documents/memberProfiles/$(profileId)/devices/$(get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.deviceId))
            && get(/databases/$(database)/documents/memberProfiles/$(profileId)/devices/$(get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.deviceId)).data.status == 'active';
        }
        function validHistoryId(id) {
          // RE2 counts Unicode code points, including supplementary emoji;
          // dot-all also permits any string content without imposing an ID format.
          return id is string && id.matches('(?s)^.{1,512}$');
        }
        function validHistorySettings(d) {
          let fields = ['schemaVersion','seenIds','revision','createdAt','updatedAt','updatedByDeviceId'];
          return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
            && d.schemaVersion is int && d.schemaVersion == 1
            && d.seenIds is list && d.seenIds.size() <= 256
            && d.seenIds.toSet().size() == d.seenIds.size()
            && d.revision is int && d.revision >= 1 && d.revision <= 9007199254740991
            && d.createdAt is timestamp && d.updatedAt is timestamp
            && d.updatedByDeviceId is string
            && d.updatedByDeviceId == get(/databases/$(database)/documents/memberIdentities/$(request.auth.uid)).data.deviceId;
        }
        // Rules cannot iterate an arbitrary list. Validate every ID inductively:
        // create permits at most one valid ID; update preserves the exact old list
        // and appends exactly one valid ID. Reordering and zero-change writes fail.
        function validHistoryAppend(d) {
          return resource.data.seenIds is list
            && d.seenIds.size() == resource.data.seenIds.size() + 1
            && validHistoryId(d.seenIds[resource.data.seenIds.size()])
            && d.seenIds == resource.data.seenIds.concat([d.seenIds[resource.data.seenIds.size()]]);
        }
        allow get: if historyOwnsProfile();
        allow list, delete: if false;
        allow create: if historyOwnsProfile() && validHistorySettings(request.resource.data)
          && request.resource.data.seenIds.size() <= 1
          && (request.resource.data.seenIds.size() == 0 || validHistoryId(request.resource.data.seenIds[0]))
          && request.resource.data.revision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if historyOwnsProfile() && validHistorySettings(request.resource.data)
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time
          && validHistoryAppend(request.resource.data);
      }
      // BEGIN GENERATED ARTIFACT SETTINGS RULES
      // Generated by scripts/generate-artifact-rules.cjs from artifact-catalog.js.
      // Do not edit repeated IDs, enums or defaults here; regenerate and run --check.
      match /settings/{artifactSettingsId} {
        function artifactDocument() { return artifactSettingsId in ['awakeningGw', 'awakeningHigh']; }
        function artifactOwnsProfile(identity) {
          return request.auth != null && identity.active == true && identity.profileId == profileId
            && identity.deviceId is string
            && get(/databases/$(database)/documents/memberProfiles/$(profileId)).data.status == 'active'
            && get(/databases/$(database)/documents/memberProfiles/$(profileId)/devices/$(identity.deviceId)).data.status == 'active';
        }
        function artifactSafeInteger(value, minimum) {
          return value is int && value >= minimum && value <= 9007199254740991;
        }
        function artifactCatalogGroup0(v0) {
          return v0.size() == 2
            && v0.needed is bool
            && v0.selectedValue.matches('^(?:1320|1440|1560|1680|1800)$');
        }
        function artifactCatalogGroup1(v0, v1, v2, v3, v4, v5) {
          return [v0.size(), v1.size(), v2.size(), v3.size(), v4.size(), v5.size()].hasOnly([2])
            && [v0.needed, v1.needed, v2.needed, v3.needed, v4.needed, v5.needed].hasOnly([true, false])
            && [v0.selectedValue, v1.selectedValue, v2.selectedValue, v3.selectedValue, v4.selectedValue, v5.selectedValue].hasOnly(['8.8%', '9.6%', '10.4%', '11.2%', '12%']);
        }
        function artifactCatalogGroup2(v0, v1, v2, v3, v4) {
          return [v0.size(), v1.size(), v2.size(), v3.size(), v4.size()].hasOnly([2])
            && [v0.needed, v1.needed, v2.needed, v3.needed, v4.needed].hasOnly([true, false])
            && [v0.selectedValue, v1.selectedValue, v2.selectedValue, v3.selectedValue, v4.selectedValue].hasOnly(['13.2%', '14.4%', '15.6%', '16.8%', '18%']);
        }
        function artifactCatalogGroup3(v0, v1, v2, v3, v4) {
          return [v0.size(), v1.size(), v2.size(), v3.size(), v4.size()].hasOnly([2])
            && [v0.needed, v1.needed, v2.needed, v3.needed, v4.needed].hasOnly([true, false])
            && [v0.selectedValue, v1.selectedValue, v2.selectedValue, v3.selectedValue, v4.selectedValue].hasOnly(['4.4%', '4.8%', '5.2%', '5.6%', '6%']);
        }
        function artifactCatalogGroup4(v0, v1, v2, v3, v4, v5) {
          return [v0.size(), v1.size(), v2.size(), v3.size(), v4.size(), v5.size()].hasOnly([2])
            && [v0.needed, v1.needed, v2.needed, v3.needed, v4.needed, v5.needed].hasOnly([true, false])
            && [v0.selectedValue, v1.selectedValue, v2.selectedValue, v3.selectedValue, v4.selectedValue, v5.selectedValue].hasOnly(['6.6%', '7.2%', '7.8%', '8.4%', '9%']);
        }
        function artifactCatalogGroup5(v0) {
          return v0.size() == 2
            && v0.needed is bool
            && v0.selectedValue.matches('^(?:660|720|780|840|900)$');
        }
        function artifactCatalogGroup6(v0, v1, v2) {
          return [v0.size(), v1.size(), v2.size()].hasOnly([2])
            && [v0.needed, v1.needed, v2.needed].hasOnly([true, false])
            && [v0.selectedValue, v1.selectedValue, v2.selectedValue].hasOnly(['2.2%', '2.4%', '2.6%', '2.8%', '3%']);
        }
        function artifactCatalogGroup7(v0) {
          return v0.size() == 2
            && v0.needed is bool
            && v0.selectedValue.matches('^(?:8800|9600|10400|11200|12000)$');
        }
        function artifactCatalogGroup8(v0) {
          return v0.size() == 2
            && v0.needed is bool
            && v0.selectedValue.matches('^(?:11000|12000|13000|14000|15000)$');
        }
        function artifactCatalogGroup9(v0) {
          return v0.size() == 2
            && v0.needed is bool
            && v0.selectedValue.matches('^(?:17\\.6%|19\\.2%|20\\.8%|22\\.4%|24%)$');
        }
        function artifactCatalogGroup10(v0) {
          return v0.size() == 2
            && v0.needed is bool
            && v0.selectedValue.matches('^(?:110000|120000|130000|140000|150000)$');
        }
        function artifactCatalogGroup11(v0) {
          return v0.size() == 2
            && v0.needed is bool
            && v0.selectedValue.matches('^(?:440|480|520|560|600)$');
        }
        function artifactCatalogGroup12(v0, v1) {
          return [v0.size(), v1.size()].hasOnly([2])
            && [v0.needed, v1.needed].hasOnly([true, false])
            && [v0.selectedValue, v1.selectedValue].hasOnly(['20%']);
        }
        function artifactItems(input) {
          let items = input;
          // Required field accesses cover every catalog ID; exact count excludes unknown IDs.
          // Item sizes plus required typed fields exclude every missing/extra item field.
          return items is map && items.size() == 63
            && [items['artifact_slot4_battle_entry_damage_boost'], items['artifact_slot4_long_cooldown_skill_damage_boost'], items['artifact_slot4_initial_hp_cost_delayed_damage_cap'], items['artifact_slot4_target_count_elemental_echo'], items['artifact_slot4_skill_use_count_damage_cap'], items['artifact_slot4_skill_damage_count_supplemental'], items['artifact_slot4_turn_charge_gauge_supplemental'], items['artifact_slot4_debuff_skill_enemy_damage_taken'], items['artifact_slot4_potion_fated_chain_gauge'], items['artifact_slot4_healing_skill_next_character_echo'], items['artifact_slot4_turn_hp_consumption_plain_damage'], items['artifact_slot4_enemy_half_hp_self_heal'], items['artifact_slot4_knockout_party_random_buff'], items['artifact_slot4_single_attack_random_buff'], items['artifact_slot4_no_attack_random_buff'], items['artifact_slot4_battle_start_random_buff'], items['artifact_slot4_attack_hit_count_flurry'], items['artifact_slot4_attack_start_chance_flurry'], items['artifact_slot4_sub_periodic_random_debuff'], items['artifact_slot4_turn_end_chance_dispel_all'], items['artifact_slot4_few_enemy_debuffs_block'], items['artifact_slot4_battle_start_damage_reduction'], items['artifact_slot4_periodic_barrier'], items['artifact_slot4_link_skill_count_cooldown_reduction'], items['artifact_slot4_skill_one_hp_cost_cooldown_reduction'], items['artifact_slot4_chance_advance_five_turns'], items['artifact_slot4_experience'], items['artifact_slot4_drop_rate'], items['artifact_slot4_battle_end_earring']].hasOnly([{'needed': false}, {'needed': true}])
            && artifactCatalogGroup0(items['artifact_slot12_attack'])
            && artifactCatalogGroup1(items['artifact_slot12_elemental_attack'], items['artifact_slot12_defense'], items['artifact_slot3_skill_damage_cap'], items['artifact_slot3_turn_damage_reduction'], items['artifact_slot3_half_hp_or_less_damage_reduction'], items['artifact_slot3_hp_defense_penalty'])
            && artifactCatalogGroup2(items['artifact_slot12_charge_attack_damage'], items['artifact_slot12_skill_damage'], items['artifact_slot12_healing'], items['artifact_slot12_critical_rate'], items['artifact_slot3_charge_cap_normal_skill_penalty'])
            && artifactCatalogGroup3(items['artifact_slot12_triple_attack_rate'], items['artifact_slot12_favorable_element_damage_reduction'], items['artifact_slot12_dodge_rate'], items['artifact_slot3_normal_cap_skill_charge_penalty'], items['artifact_slot3_charge_special_damage_cap'])
            && artifactCatalogGroup4(items['artifact_slot12_double_attack_rate'], items['artifact_slot12_debuff_success_rate'], items['artifact_slot12_debuff_resistance'], items['artifact_slot3_charge_damage_cap'], items['artifact_slot3_half_hp_or_more_triple_attack'], items['artifact_slot3_chain_damage'])
            && artifactCatalogGroup5(items['artifact_slot12_hp'])
            && artifactCatalogGroup6(items['artifact_slot3_full_hp_damage'], items['artifact_slot3_critical_damage_cap'], items['artifact_slot3_normal_damage_cap'])
            && artifactCatalogGroup7(items['artifact_slot3_normal_supplemental_damage'])
            && artifactCatalogGroup8(items['artifact_slot3_skill_supplemental_damage'])
            && artifactCatalogGroup9(items['artifact_slot3_skill_cap_normal_charge_penalty'])
            && artifactCatalogGroup10(items['artifact_slot3_charge_supplemental_damage'])
            && artifactCatalogGroup11(items['artifact_slot3_regeneration'])
            && artifactCatalogGroup12(items['artifact_slot3_buff_removal_resistance'], items['artifact_slot3_attack_start_debuff_recovery']);
        }
